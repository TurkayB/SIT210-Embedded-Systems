    {
        "id": "2b3ec01a29b1b559",
        "type": "function",
        "z": "8eb383b3f8431e5d",
        "name": "Check Humidity",
        "func": "let data = msg.payload;\n\nif (isNaN(data)) {\n  msg.payload = \"NOT CONNECTED\";\n  return msg;\n}\n\nlet humidityMinimum = global.get(\"humidityMin\");\nlet humidityMaximum = global.get(\"humidityMax\");\n\nif (data >= humidityMinimum && data <= humidityMaximum) {\n  msg.payload = \"OK\";\n  global.set(\"humidityViolated\", false);\n} else {\n  msg.payload = \"ALERT\";\n}\n\nif ((data < humidityMinimum || data > humidityMaximum) && global.get(\"tempViolated\") === false) {\n  global.set(\"humidityViolations\", (global.get(\"humidityViolations\")) + 1);\n  global.set(\"humidityViolated\", true);\n}\n\nreturn msg;",
        "outputs": 1,
