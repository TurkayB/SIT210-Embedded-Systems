        ]
    },
    {
        "id": "e6686e823c348e4a",
        "type": "function",
        "z": "8eb383b3f8431e5d",
        "name": "Check Moisture",
        "func": "let data = msg.payload;\n\nlet soilMinimum = global.get(\"soilMin\");\nlet soilMaximum = global.get(\"soilMax\");\n\nif (data >= soilMinimum && data <= soilMaximum) {\n    msg.payload = \"OK\";\n    global.set(\"soilViolated\", false);\n} else {\n    msg.payload = \"ALERT\";\n}\n\nif ((data < soilMinimum || data > soilMaximum) && global.get(\"soilViolated\") === false) {\n    global.set(\"soilViolations\", (global.get(\"soilViolations\")) + 1);\n    global.set(\"soilViolated\", true);\n}\n\nreturn msg;",
