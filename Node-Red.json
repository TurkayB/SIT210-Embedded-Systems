    {
        "id": "64a503088d45df3a",
        "type": "function",
        "z": "8eb383b3f8431e5d",
        "name": "Check Light",
        "func": "let data = msg.payload;\n\nif (data === -1) {\n  msg.payload = \"NOT CONNECTED\";\n  return msg;\n}\n\nlet lightMinimum = global.get(\"lightMin\");\nlet lightMaximum = global.get(\"lightMax\");\n\nif (data >= lightMinimum && data <= lightMaximum) {\n    msg.payload = \"OK\";\n    global.set(\"lightViolated\", false);\n} else {\n    msg.payload = \"ALERT\";\n}\n\nif ((data < lightMinimum || data > lightMaximum) && global.get(\"lightViolated\") === false) {\n  global.set(\"lightViolations\", (global.get(\"lightViolations\")) + 1);\n  global.set(\"lightViolated\", true);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
