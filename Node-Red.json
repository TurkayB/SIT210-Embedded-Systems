    {
        "id": "fb25584f7864ad71",
        "type": "function",
        "z": "8eb383b3f8431e5d",
        "name": "Write Report",
        "func": "let _tempViolations = global.get(\"tempViolations\");\nlet _humidityViolations = global.get(\"humidityViolations\");\nlet _lightViolations = global.get(\"lightViolations\");\nlet _soilViolations = global.get(\"soilViolations\");\n\nlet totalViolations = _tempViolations + _humidityViolations + _lightViolations + _soilViolations;\n\nlet _streak = global.get(\"streak\") || 0;\n\nif (totalViolations === 0) {\n    _streak += 1;\n} else {\n    _streak = 0;\n}\n\nglobal.set(\"streak\", _streak);\n\nlet grade = \"A\";\n\nif (totalViolations > 20) {\n    grade = \"E\";\n} else if (totalViolations > 15) {\n    grade = \"D\";\n} else if (totalViolations > 10) {\n    grade = \"C\";\n} else if (totalViolations > 5) {\n    grade = \"B\";\n}\n\nmsg.payload = `\n🌿 Daily Plant Health Report 🌿\n\nTemperature Violations: ${_tempViolations}\nHumidity Violations: ${_humidityViolations}\nLight Violations: ${_lightViolations}\nSoil Moisture Violations: ${_soilViolations}\n\nTotal Violations: ${totalViolations}\nHealth Grade: ${grade}\n🔥 Streak: ${_streak} day(s) without any violations!\n\n📆 Date: ${new Date().toLocaleString()}\n`;\n\nmsg.topic = \"Daily Plant Health Report\";\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
