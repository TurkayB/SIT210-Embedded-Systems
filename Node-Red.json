    {
        "id": "check_thresholds",
        "type": "function",
        "z": "8eb383b3f8431e5d",
        "name": "Check Temp",
        "func": "let data = msg.payload;\n\nif (isNaN(data)) {\n  msg.payload = \"NOT CONNECTED\";\n  return msg;\n}\n\nlet tempMinimum = global.get(\"tempMin\");\nlet tempMaximum = global.get(\"tempMax\");\n\nif (data >= tempMinimum && data <= tempMaximum) {\n  msg.payload = \"OK\";\n  global.set(\"tempViolated\", false);\n} else {\n  msg.payload = \"ALERT\";\n}\n\nif ((data < tempMinimum || data > tempMaximum) && global.get(\"tempViolated\") === false) {\n  global.set(\"tempViolations\", (global.get(\"tempViolations\")) + 1);\n  global.set(\"tempViolated\", true);\n}\n\nreturn msg;",
        "outputs": 1,
        "timeout": "",
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 790,
        "y": 240,
        "wires": [
            [
                "temp_status"
            ]
        ]
    },
